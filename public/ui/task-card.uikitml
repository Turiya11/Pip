<!--
  Task card for the selected orb. Authored at 10x and placed at scale 0.1,
  so the card is 44 cm wide next to the 0.8 m Pip (it scales with Pip).
-->
<style>
  .card {
    flex-direction: column;
    width: 440px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 22px;
    padding-bottom: 24px;
    gap: 10px;
    background-color: #1a1333;
    border-color: #b794f6;
    border-width: 2px;
    border-radius: 28px;
  }
  .top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .eyebrow {
    color: #c4b5fd;
    font-size: 16px;
    font-weight: 700;
  }
  .close {
    width: 52px;
    height: 52px;
    justify-content: center;
    align-items: center;
    border-radius: 26px;
    background-color: #2a2150;
    border-color: #6d5bd0;
    border-width: 2px;
    cursor: pointer;
  }
  .close-label {
    color: #f5f4ff;
    font-size: 22px;
    font-weight: 700;
  }
  .title {
    color: #f5f4ff;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.25;
  }
  .label {
    color: #a78bfa;
    font-size: 17px;
    font-weight: 600;
    margin-top: 6px;
  }
  .body {
    color: #e9e7ff;
    font-size: 22px;
    line-height: 1.3;
  }
  .actions {
    flex-direction: row;
    gap: 12px;
    margin-top: 12px;
  }
  .focus {
    flex-grow: 1;
    height: 64px;
    justify-content: center;
    align-items: center;
    border-radius: 32px;
    background-color: #8b5cf6;
    cursor: pointer;
  }
  .focus-label {
    color: #f5f4ff;
    font-size: 22px;
    font-weight: 700;
  }
  .done {
    flex-grow: 1;
    height: 64px;
    justify-content: center;
    align-items: center;
    border-radius: 32px;
    background-color: #00d1c1;
    cursor: pointer;
  }
  .done-label {
    color: #0f0d1f;
    font-size: 22px;
    font-weight: 700;
  }
</style>
<div id="card" class="card">
  <div class="top">
    <span class="eyebrow">PARKED THOUGHT</span>
    <div id="card-close" class="close"><span class="close-label">X</span></div>
  </div>
  <span id="card-title" class="title">Thought title</span>
  <span class="label">What you were doing</span>
  <span id="card-context" class="body">Not added yet</span>
  <span class="label">Smallest next step</span>
  <span id="card-next" class="body">Not added yet</span>
  <div class="actions">
    <div id="card-focus" class="focus"><span class="focus-label">Focus</span></div>
    <div id="card-done" class="done"><span class="done-label">Mark done</span></div>
  </div>
</div>
