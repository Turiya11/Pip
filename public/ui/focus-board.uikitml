<!--
  Focus Mode: the text layer on the front of the glass thinking board. Authored at 10x and
  placed at scale 0.1, so it is 1.2 m x 0.74 m. The glass slab itself is 3D geometry behind
  it; this layer keeps a transparent background so the glass shows through.
-->
<style>
  .board {
    flex-direction: column;
    width: 1200px;
    height: 740px;
    padding-left: 44px;
    padding-right: 40px;
    padding-top: 34px;
    padding-bottom: 26px;
    gap: 18px;
  }
  .header {
    flex-direction: row;
    align-items: center;
    gap: 22px;
  }
  .anchor-space {
    width: 96px;
    height: 96px;
  }
  .heading {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    gap: 6px;
  }
  .eyebrow {
    color: #c4b5fd;
    font-size: 18px;
    font-weight: 700;
  }
  .title {
    color: #f5f4ff;
    font-size: 44px;
    font-weight: 700;
    line-height: 1.15;
  }
  .back {
    height: 72px;
    padding-left: 30px;
    padding-right: 30px;
    justify-content: center;
    align-items: center;
    border-radius: 36px;
    background-color: #2a2150;
    border-color: #b794f6;
    border-width: 2px;
    cursor: pointer;
  }
  .back-label {
    color: #f5f4ff;
    font-size: 24px;
    font-weight: 700;
  }
  .body {
    flex-direction: row;
    flex-grow: 1;
    gap: 24px;
  }
  .canvas {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding-left: 8px;
    padding-bottom: 6px;
  }
  .canvas-label {
    color: #8b7fd6;
    font-size: 18px;
    font-weight: 600;
  }
  .context {
    width: 360px;
    flex-direction: column;
    gap: 8px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 22px;
    border-radius: 24px;
    background-color: #1a1333;
    border-color: #6d5bd0;
    border-width: 2px;
  }
  .context-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .context-heading {
    color: #e9e7ff;
    font-size: 20px;
    font-weight: 700;
  }
  .toggle {
    height: 48px;
    padding-left: 18px;
    padding-right: 18px;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    background-color: #2a2150;
    cursor: pointer;
  }
  .toggle-label {
    color: #f5f4ff;
    font-size: 18px;
    font-weight: 600;
  }
  .context-body {
    flex-direction: column;
    gap: 6px;
  }
  .label {
    color: #a78bfa;
    font-size: 17px;
    font-weight: 600;
    margin-top: 8px;
  }
  .value {
    color: #f5f4ff;
    font-size: 21px;
    line-height: 1.3;
  }
  .footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .tools {
    flex-direction: row;
    gap: 14px;
  }
  .tool {
    height: 64px;
    padding-left: 26px;
    padding-right: 26px;
    justify-content: center;
    align-items: center;
    border-radius: 32px;
    background-color: #2a2150;
    border-color: #8b7fd6;
    border-width: 2px;
    cursor: pointer;
  }
  .tool-label {
    color: #f5f4ff;
    font-size: 22px;
    font-weight: 700;
  }
  .status {
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }
  .saved {
    color: #a99ee6;
    font-size: 18px;
  }
  .undo {
    height: 52px;
    padding-left: 22px;
    padding-right: 22px;
    justify-content: center;
    align-items: center;
    border-radius: 26px;
    background-color: #00d1c1;
    cursor: pointer;
  }
  .undo-label {
    color: #0f0d1f;
    font-size: 19px;
    font-weight: 700;
  }
</style>
<div class="board">
  <div class="header">
    <div class="anchor-space"></div>
    <div class="heading">
      <span class="eyebrow">FOCUS MODE</span>
      <span id="focus-title" class="title">Thought title</span>
    </div>
    <div id="focus-back" class="back"><span class="back-label">Back to Orbit</span></div>
  </div>
  <div class="body">
    <div id="focus-canvas" class="canvas">
      <span id="focus-canvas-label" class="canvas-label">Thinking canvas</span>
    </div>
    <div id="focus-context" class="context">
      <div class="context-top">
        <span class="context-heading">Thought context</span>
        <div id="focus-context-toggle" class="toggle"><span id="focus-context-toggle-label" class="toggle-label">Hide</span></div>
      </div>
      <div id="focus-context-body" class="context-body">
        <span class="label">Original thought</span>
        <span id="ctx-title" class="value">-</span>
        <span class="label">What you were doing</span>
        <span id="ctx-context" class="value">Not added yet</span>
        <span class="label">Next action</span>
        <span id="ctx-next" class="value">Not added yet</span>
        <span class="label">Sub-tasks</span>
        <span id="ctx-progress" class="value">None yet</span>
      </div>
    </div>
  </div>
  <div class="footer">
    <div class="tools">
      <div id="focus-add-sticky" class="tool"><span class="tool-label">+ Add Sticky</span></div>
      <div id="focus-breakdown" class="tool"><span class="tool-label">Break Down</span></div>
    </div>
    <div class="status">
      <span id="focus-saved" class="saved">Saved</span>
      <div id="focus-undo" class="undo" style="display: none"><span class="undo-label">Undo</span></div>
    </div>
  </div>
</div>
